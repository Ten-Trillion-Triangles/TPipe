FROM --platform=linux/arm64 eclipse-temurin:24-jre

WORKDIR /opt/tpipe
COPY agentcore-live-smoke-all.jar /opt/tpipe/agentcore-live-smoke-all.jar

ENV TPIPE_AGENTCORE_PROTOCOL=MCP
ENV TPIPE_AGENTCORE_BIND_ADDRESS=0.0.0.0
ENV TPIPE_AGENTCORE_PORT=8000

EXPOSE 8000
ENTRYPOINT ["java", "-cp", "/opt/tpipe/agentcore-live-smoke-all.jar", "com.TTT.AgentCore.LiveSmoke.LiveSmokeRuntimeMainKt"]
